CATALOG_MODE=mock
MOCK_CATALOG_ORIGIN=http://localhost:4040

# Genau EINEN Block aktiv lassen (Zeilen ohne #).
# Beim Wechsel den bisherigen Block vollständig auskommentieren.
# Account, API-Key und Abrechnung: siehe ../../00-setup-check/README.md.
# ChatGPT ist kein eigener API-Provider: dafür OpenAI verwenden.

# Google (Gemini)
AI_PROVIDER=google
AI_MODEL=gemini-3.1-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# Anthropic (Claude)
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

CHAT_MAX_OUTPUT_TOKENS=2048
CHAT_TIMEOUT_MS=30000

# Nur für eine öffentliche Demo aktivieren; lokal bleiben MCP-Übungen unverändert.
ENABLE_PUBLIC_MCP_GUARDS=false
MCP_MAX_REQUEST_BYTES=256000
MCP_MAX_REQUESTS_PER_MINUTE=120
